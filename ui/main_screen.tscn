[gd_scene format=3]

[ext_resource type="Script" path="res://ui/main_screen.gd" id="1_screen"]
[ext_resource type="PackedScene" path="res://ui/credits_panel.tscn" id="2_credits"]

[node name="MainScreen" type="MarginContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 64
theme_override_constants/margin_top = 64
theme_override_constants/margin_right = 64
theme_override_constants/margin_bottom = 64
script = ExtResource("1_screen")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_vertical = 4
theme_override_constants/separation = 32

[node name="MessageLabel" type="Label" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
horizontal_alignment = 1
autowrap_mode = 3

[node name="ActionList" type="VBoxContainer" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4

[node name="CreditsButton" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 8
size_flags_vertical = 8
flat = true
text = "Créditos"

[node name="CreditsPanel" parent="." instance=ExtResource("2_credits")]
unique_name_in_owner = true
visible = false
layout_mode = 2
