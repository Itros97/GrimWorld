[ext_resource type="Shader" path="res://ui/light_background.gdshader" id="3_light"]

[sub_resource type="ShaderMaterial" id="ShaderMaterial_light"]
shader = ExtResource("3_light")

[node name="MainScreen" type="Control"]
layout_mode = 3
